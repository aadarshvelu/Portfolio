{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resume-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Owner-only editor + save/load JSON store. Create once with:
  //   wrangler kv namespace create RESUME_KV
  // then paste the printed id below (also add the same binding in the
  // dashboard: Pages project → Settings → Functions → KV namespace bindings,
  // if this project deploys via git integration rather than `wrangler deploy`).
  "kv_namespaces": [
    { "binding": "RESUME_KV", "id": "37638403546c4fd3a01c1ae35281ba20" }
  ],

  // Stores the uploaded resume PDF (binary — R2 is the right tool, not KV).
  // Create once with:
  //   wrangler r2 bucket create resume-pdf
  "r2_buckets": [
    { "binding": "RESUME_PDF", "bucket_name": "resume-pdf" }
  ],

  // Defense-in-depth owner check in the API routes (see requireOwner) — the
  // email you sign into Cloudflare Access with. Mirror this in the dashboard:
  // Pages project → Settings → Environment variables → OWNER_EMAIL.
  "vars": {
    "OWNER_EMAIL": "aadarshvelu@gmail.com"
  }
}
